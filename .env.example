# ---------------------------------------------------------------------------
# Copy this file to `.env` (git-ignored) and fill in real values.
# No real secrets belong in this committed example file.
# ---------------------------------------------------------------------------

# --- Session signing ---
# Optional. Leave empty to have a random secret generated on first run and
# persisted in the database. Set it explicitly to pin sessions to a known key.
SECRET_KEY=

# Session cookie lifetime in seconds (default 7 days).
SESSION_MAX_AGE=604800

# Set to "true" in production (HTTPS). Set to "false" for local http dev/tests.
COOKIE_SECURE=true

# --- Storage ---
# MongoDB Atlas connection string (M0 free tier is fine).
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net
# Database name within that cluster. Tests use `<MONGODB_DB>_test`.
MONGODB_DB=rag

# --- Login rate limiting ---
# Max failed login attempts per client IP within the window.
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# --- Uploads and ingestion ---
# Largest file accepted at upload, in bytes (default 10 MB).
MAX_UPLOAD_BYTES=10485760
# Chunking: characters per chunk and overlap between adjacent chunks.
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# --- Embeddings (OpenRouter, OpenAI-shaped embeddings endpoint) ---
# Free `:free` models require enabling the free-model data policy in your
# OpenRouter privacy settings, and are rate limited.
OPENROUTER_API_KEY=replace-with-your-openrouter-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free
# 0 = auto-detect the model's native dimensions from its first response. Set a
# number to pin it (required to create the Atlas vector index's numDimensions).
EMBEDDING_DIMENSIONS=0
# Number of chunk texts sent per embeddings request.
EMBEDDING_BATCH_SIZE=64

# --- Chat (used when streaming chat is implemented) ---
# "openrouter/free" routes to whichever free model is available.
CHAT_MODEL=openrouter/free

# --- Retrieval ---
# "local" (Mongo-backed cosine) or "atlas" ($vectorSearch). Atlas requires the
# one-time index documented in the README.
VECTOR_STORE_BACKEND=local
# Name of the Atlas vector search index on the `chunks` collection.
ATLAS_VECTOR_INDEX=chunks_vector_index
# Candidates considered by $vectorSearch before the top-k is taken.
ATLAS_NUM_CANDIDATES=100
# Chunks returned per query.
RETRIEVAL_TOP_K=5
# Chunks scoring below this are treated as "nothing relevant found".
RETRIEVAL_MIN_SCORE=0.05
